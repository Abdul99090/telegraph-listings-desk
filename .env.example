# Live mode needs NO API key and NO hosted URL (verified 14 Nov 2026,
# docs/MCP-TOOLS.md). The official MCP server runs locally over stdio
# and holds a dedicated wallet created by its own setup command:
#
#   npx -y @telegraphprotocol/telegraph-protocol-mcp setup
#
# The wallet lives at ~/.telegraph/wallet.json (mode 0600) — never copy
# it into this project and never commit it.

# Optional: override the Telegraph home directory (default ~/.telegraph).
TELEGRAPH_HOME=

# Hard per-run spend ceiling for intelligence purchases, in USD
# (live asks are priced in test USDC, ~$0.01 each; the server itself
# also caps at $0.50/ask and $5/day by default).
# The desk refuses to start a run whose planned purchases exceed this.
TELEGRAPH_MAX_SPEND_PER_RUN=100
